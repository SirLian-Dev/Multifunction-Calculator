<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.julian.multicalc.presentation.controller.ShellController"
            prefWidth="1200.0" prefHeight="720.0"
            styleClass="app-root">

    <left>
        <VBox spacing="10" prefWidth="220" styleClass="sidebar" BorderPane.alignment="CENTER">
            <Label text="MultiCalc" styleClass="app-title"/>
            <Separator/>

            <Button text="Calculadora" onAction="#showCalculator" maxWidth="Infinity"/>
            <Button text="Conversiones" onAction="#showConversions" maxWidth="Infinity"/>
            <Button text="Divisas" onAction="#showCurrency" maxWidth="Infinity"/>
            <Button text="Historial" onAction="#showHistory" maxWidth="Infinity"/>
            <Button text="Opciones" onAction="#showSettings" maxWidth="Infinity"/>
        </VBox>
    </left>

    <top>
        <HBox spacing="10" styleClass="topbar" BorderPane.alignment="CENTER_LEFT">
            <Label text="Proyecto Calculadora Multifunción" styleClass="topbar-title"/>
        </HBox>
    </top>

    <center>
        <StackPane fx:id="contentPane" styleClass="content-area"/>
    </center>

</BorderPane>